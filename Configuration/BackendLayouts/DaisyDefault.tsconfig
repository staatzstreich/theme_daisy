mod {
    web_layout {
        BackendLayouts {
            daisydefault {
                title = LLL:EXT:theme_daisy/Resources/Private/Language/backend_layouts.xlf:backend_layout.daisydefault.title
                config {
                    backend_layout {
                        colCount = 1
                        rowCount = 1
                        rows {
                            1 {
                                columns {
                                    1 {
                                        name = LLL:EXT:theme_daisy/Resources/Private/Language/backend_layouts.xlf:backend_layout.column.main.name
                                        colPos = 0
                                        colspan = 1
                                        identifier = main
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}