mod {
    web_layout {
        BackendLayouts {
            daisyfooter {
                title = LLL:EXT:theme_daisy/Resources/Private/Language/backend_layouts.xlf:backend_layout.daisyfooter.title
                config {
                    backend_layout {
                        colCount = 3
                        rowCount = 2
                        rows {
                            1 {
                                columns {
                                    1 {
                                        name = LLL:EXT:theme_daisy/Resources/Private/Language/backend_layouts.xlf:backend_layout.column.main.name
                                        colPos = 0
                                        colspan = 3
                                        identifier = main
                                    }
                                }
                            }
                            2 {
                                columns {
                                    1 {
                                        name = LLL:EXT:theme_daisy/Resources/Private/Language/backend_layouts.xlf:backend_layout.column.footer1.name
                                        colPos = 100
                                        identifier = footer1
                                        slideMode = slide
                                    }
                                    2 {
                                        name = LLL:EXT:theme_daisy/Resources/Private/Language/backend_layouts.xlf:backend_layout.column.footer2.name
                                        colPos = 101
                                        identifier = footer2
                                        slideMode = slide
                                    }
                                    3 {
                                        name = LLL:EXT:theme_daisy/Resources/Private/Language/backend_layouts.xlf:backend_layout.column.footer3.name
                                        colPos = 102
                                        identifier = footer3
                                        slideMode = slide
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}