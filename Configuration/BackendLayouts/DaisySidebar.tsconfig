mod {
    web_layout {
        BackendLayouts {
            daisysidebar {
                title = LLL:EXT:theme_daisy/Resources/Private/Language/backend_layouts.xlf:backend_layout.daisysidebar.title
                icon = EXT:theme_daisy/Resources/Public/Icons/BackendLayouts/daisysidebar.svg
                config {
                    backend_layout {
                        colCount = 4
                        rowCount = 1
                        rows {
                            1 {
                                columns {
                                    1 {
                                        name = LLL:EXT:theme_daisy/Resources/Private/Language/backend_layouts.xlf:backend_layout.column.main.name
                                        colPos = 0
                                        colspan = 3
                                        identifier = main
                                    }
                                    2 {
                                        name = LLL:EXT:theme_daisy/Resources/Private/Language/backend_layouts.xlf:backend_layout.column.sidebar.name
                                        colPos = 1
                                        identifier = sidebar
                                        slideMode = slide
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}