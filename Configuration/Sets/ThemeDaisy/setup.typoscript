@import './TypoScript/*.typoscript'

# -----------------------------------------------------------------------
# Default theme of the site: the selected daisyUI theme is stamped as
# data-theme on the <html> element so it applies before any layout markup.
# Visitors can override it client-side (Resources/Public/JavaScript/theme-daisy.js
# + the theme switcher in the navbar component).
# -----------------------------------------------------------------------
config.htmlTag.attributes {
    data-theme = light
    data-theme {
        data = sitesettings:theme.daisy.defaultTheme
        ifEmpty = light
    }
}

page = PAGE
page {
    10 = PAGEVIEW
    10 {
        paths {
            0 = EXT:theme_daisy/Resources/Private/Templates/
        }
        dataProcessing {
            10 = page-content
            20 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            20 {
                levels = 1
                as = mainMenu
            }
        }
    }
}

# Page template per backend layout (explicit CASE instead of betting on
# PAGEVIEW's backend-layout-to-template-name resolution).
page.10.templateName.cObject = CASE
page.10.templateName.cObject {
    key.data = field:backend_layout
    default = TEXT
    default.value = Default
    pagets__daisystartpage = TEXT
    pagets__daisystartpage.value = Startpage
    pagets__daisysidebar = TEXT
    pagets__daisysidebar.value = Sidebar
    pagets__daisyfooter = TEXT
    pagets__daisyfooter.value = Footer
    pagets__daisycomponentreference = TEXT
    pagets__daisycomponentreference.value = ComponentReference
}