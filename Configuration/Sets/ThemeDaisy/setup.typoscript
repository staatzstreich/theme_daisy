@import './TypoScript/*.typoscript'

# -----------------------------------------------------------------------
# Default theme of the site: the selected daisyUI theme is stamped as
# data-theme on the <html> element so it applies before any layout markup.
# Visitors can override it client-side (Resources/Public/JavaScript/theme-daisy.js
# + the theme switcher in the navbar component).
# -----------------------------------------------------------------------
config.htmlTag.attributes {
    data-theme = light
    data-theme {
        data = sitesettings:theme.daisy.defaultTheme
        ifEmpty = light
    }
}

page = PAGE
page {
    10 = PAGEVIEW
    10 {
        paths {
            0 = EXT:theme_daisy/Resources/Private/Templates/
        }
        # PAGEVIEW renders the template named after the backend layout
        # identifier (e.g. "daisydefault" -> Templates/Pages/daisydefault.fluid.html),
        # so the template files in Templates/Pages/ must keep these names.
        dataProcessing {
            10 = page-content
            20 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            20 {
                levels = 2
                as = mainMenu
            }
            30 = TYPO3\CMS\Frontend\DataProcessing\LanguageMenuProcessor
            30 {
                # "auto" = all languages of the current site configuration
                languages = auto
                as = languageMenu
            }
            40 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
            40 {
                # rootline for the breadcrumb below the navbar
                special = rootline
                as = breadcrumb
                dataProcessing.10 = record-transformation
            }
        }
    }
}